<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>default</LangVersion>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>CoreRemoting</Title>
        <Authors>Hagen Siegel</Authors>
        <Description>Easy to use Remoting library for .NET Core and .NET Framework</Description>
        <Copyright>2026 Hagen Siegel</Copyright>
        <PackageTags>Remoting RPC Network</PackageTags>
        <Company>Hagen Siegel</Company>
        <AssemblyVersion>1.3.7.0</AssemblyVersion>
        <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
        <PackageProjectUrl>https://github.com/theRainbird/CoreRemoting</PackageProjectUrl>
        <PackageLicenseUrl></PackageLicenseUrl>
        <RepositoryUrl>https://github.com/theRainbird/CoreRemoting.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageVersion>1.3.7.0</PackageVersion>
        <PackageReleaseNotes>- New: TcpServerChannel can be bound to a specific IP address via optional listenerIpAddress constructor parameter (previously always all interfaces).
- Fixed: crash on Dispose after Close (#226); client disconnection after server close; server process termination when closing an inactive session threw; null deserialized SerializedDiffGram; leaks of SHA256, PrincipalContext/UserPrincipal; Hashtable BSON deserialization issues (now Dictionary).
- Fixed: NeoBinary deserialization of cycles running through collections (#252): list items, array elements and dictionary values that refer to an object which is still being deserialized are now restored correctly instead of silently becoming null or throwing InvalidCastException/ArgumentException.
- Improved: NeoBinarySerializer dispatch and deserialization performance.
- Updated NuGet packages, incl. WatsonTcp 6.0.11 → 6.5.0 (~14x lower TCP round-trip latency on .NET Framework).
- Security: Updated vulnerable transitive dependencies System.Formats.Asn1 (CVE-2024-38095) and System.Text.Json (CVE-2024-43485) to 10.0.14; removed redundant Cng/OpenSsl package references from the net8.0 target.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="CoreRemoting.Tests" />
    </ItemGroup>
    
    <PropertyGroup>
      <NoWarn>$(NoWarn),NU1701</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DocumentationFile>bin\Debug\CoreRemoting.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DocumentationFile>bin\Release\CoreRemoting.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Castle.Windsor" Version="6.0.0" />
      <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.14" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
      <PackageReference Include="Newtonsoft.Json.Bson" Version="1.0.3" />
      <PackageReference Include="Serialize.Linq" Version="4.4.1" />
      <PackageReference Include="stakx.DynamicProxy.AsyncInterceptor" Version="0.1.0" />
      <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
      <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
      <!-- Security override: CVE-2024-38095 (System.Formats.Asn1) / CVE-2024-43485 (System.Text.Json) -->
      <PackageReference Include="System.Formats.Asn1" Version="10.0.14" />
      <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
      <PackageReference Include="System.Security.Cryptography.Algorithms" Version="4.3.1" />
      <PackageReference Include="System.Security.Principal.Windows" Version="5.0.0" />
      <PackageReference Include="System.Text.Json" Version="10.0.14" />
      <PackageReference Include="WatsonTcp" Version="6.5.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
      <PackageReference Include="System.Security.Cryptography.Cng" Version="5.0.0" />
      <PackageReference Include="System.Security.Cryptography.OpenSsl" Version="5.0.0" />
    </ItemGroup>

    <ItemGroup>
      <Protobuf Include="**/*.proto" />
    </ItemGroup>

</Project>
