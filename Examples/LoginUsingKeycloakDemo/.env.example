# Copy this file to ".env" and fill in the values. The ".env" file itself is ignored by git.
# All configuration is read from environment variables; there are no hardcoded server names.

# Full issuer URL of the Keycloak realm. Must match the "iss" claim of the issued token and
# the issuer configured on the CoreRemoting server side.
# Example: https://keycloak:8443/realms/my-realm
KEYCLOAK_ISSUER=

# OAuth client id of the CoreRemoting client in Keycloak. Also used as the accepted audience on the server.
KEYCLOAK_CLIENT_ID=

# Optional client secret. Leave empty for a public client (Authorization Code flow with PKCE).
KEYCLOAK_CLIENT_SECRET=

# Optional redirect URI. Leave empty to use an automatic loopback redirect (http://127.0.0.1:<port>/).
KEYCLOAK_REDIRECT_URI=

# Optional comma-separated scopes. Default: openid,profile
KEYCLOAK_SCOPES=openid,profile

# DEV-ONLY: set to true to accept invalid server certificates (e.g., self-signed certs of a LAN Keycloak).
# Do NOT enable in production — install the CA certificate instead.
KEYCLOAK_ACCEPT_SELF_SIGNED_CERTS=false
